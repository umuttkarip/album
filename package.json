{
  "name": "album",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite --config vite.pages.config.ts",
    "build": "vite build --config vite.pages.config.ts",
    "test": "tsx --test tests/*.test.ts",
    "dev:api": "wrangler dev --config wrangler.album.jsonc --local --persist-to .wrangler/independent --ip 127.0.0.1 --port 8787",
    "deploy:api": "wrangler deploy --config wrangler.album.jsonc"
  },
  "dependencies": {
    "@react-three/fiber": "^9.3.0",
    "three": "^0.180.0",
    "konva": "^10.0.0",
    "react-konva": "19.2.0",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
