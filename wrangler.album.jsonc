{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "album-api",
  "account_id": "948e8da41b75ca43f86a24a581d60796",
  "main": "independent/worker.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "ALBUM_ALLOWED_ORIGINS": "https://umuttkarip.github.io,http://127.0.0.1:5174" },
  "d1_databases": [{ "binding": "DB", "database_name": "album", "database_id": "860d1535-d623-46a5-8d9b-af945594a173", "migrations_dir": "drizzle" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "album" }]
}
